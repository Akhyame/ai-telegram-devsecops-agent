# Application
APP_ENV=development
LOG_LEVEL=INFO

# GitLab
GITLAB_PROJECT_ID=

# Telegram
# Add the BotFather token only to the local ignored .env file.
# Never commit or share the real token in chat, logs, screenshots, or tests.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs; empty means deny everyone.
TELEGRAM_ALLOWED_USER_IDS=
# Allowed users without a privileged role are Viewers.
# Every Operator and Admin ID must also be in TELEGRAM_ALLOWED_USER_IDS.
TELEGRAM_OPERATOR_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
# Optional non-secret application URL appended to successful staging notifications.
# The staging Compose default is the local SSH-tunnel demo URL below.
STAGING_SITE_URL=http://127.0.0.1:18001/

# Local-only AI provider.
# No API key or paid cloud AI service is required.
AI_PROVIDER=ollama-local
OLLAMA_API_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen3.5:4b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_CHARS=1200
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_DEFAULT_REF=main
GITLAB_API_TOKEN=
# Separate project-scoped credential for controlled write actions.
# Never reuse the read-only token or store a real value in this file.
GITLAB_WRITE_API_TOKEN=

# Separate project-scoped credential reserved for controlled deployments.
# Grant only the minimum GitLab permission required by the deployment workflow.
# Never reuse another API token or commit the real value.
DEPLOYMENT_IMAGE_REPOSITORY=registry.gitlab.com/akhyames/ai-telegram-devsecops-agent

# GitLab webhook signing
# Generate this token in GitLab Webhook settings.
# Store the real value only in the ignored local .env file.
GITLAB_WEBHOOK_SIGNING_TOKEN=
ALERTMANAGER_RECEIVER_TOKEN=
